# Required. Copy this to `.env` (gitignored) and set your Deepgram key.
# The app reads it from process.env.DEEPGRAM_API_KEY at startup.

DEEPGRAM_API_KEY=

# Optional, dev-only. Set to 1 to capture a verbose model's-eye debug log of
# every prep/call session to ~/.prompty/debug/*.{jsonl,md} — the recording
# source for the replay harness (see app/PROMPTING.md). Off when absent; ships
# in every build but is invisible to external users (who never get a `.env`).
# PROMPTY_DEBUG=1
